{
  "//": "No se compila nada: TypeScript se usa solo como chequeador del JS que ya hay (checkJs + noEmit). Corre con 'npm run typecheck'.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.mjs", "test/**/*.mjs"]
}
